{
  "contractVersion": 4,
  "application": {
    "id": "bauman-master-ai",
    "name": "Bauman Master AI",
    "tier": "client",
    "repository": "BlueDragon33/Bauman-master-ai-system"
  },
  "boundary": {
    "independentRuntime": true,
    "embeddedInApplicationManagement": false,
    "sharedDatabaseWithApplicationManagement": false,
    "sharedDeviceRegistryWithOtherClients": false
  },
  "readiness": {
    "runtime": "available",
    "subclientInventory": "available",
    "readOnlyControlApi": "available",
    "deviceRegistry": "implemented-requires-d1",
    "deviceGateway": "implemented-requires-d1-and-app-origin",
    "mutationAdminApi": "implemented-requires-d1",
    "auditApi": "implemented-requires-d1",
    "p256ChallengeProof": "implemented-requires-d1-and-app-origin",
    "revocableDeviceSessions": "implemented-requires-d1-and-app-origin",
    "learningAccessGate": "missing",
    "contentReviewApi": "missing"
  },
  "controlService": {
    "location": "control-service/",
    "protocol": "bauman-control-v4",
    "audience": "bauman-control",
    "routes": [
      "/health",
      "/api/control/status",
      "/api/control/subclients",
      "/api/control/devices",
      "/api/control/device-commands",
      "/api/control/audit",
      "/api/device/register",
      "/api/device/challenge",
      "/api/device/verify",
      "/api/device/heartbeat",
      "/api/device/status"
    ],
    "mutationsEnabled": "runtime-gated-by-d1",
    "commandSemantics": {
      "idempotencyKey": "commandId",
      "optimisticConcurrency": "expectedStatus",
      "blockPreservesRegistry": true,
      "blockRevokesDeviceSessions": true,
      "ownerOnlyMutations": true
    }
  },
  "requiredDeviceContract": {
    "namespace": "BM-",
    "identity": "sha256-canonical-p256-public-key",
    "classes": ["desktop", "tablet", "phone", "unknown"],
    "accessAndEditSeparated": true,
    "privateKeyLocation": "endpoint-only",
    "challengeTtlSeconds": 120,
    "deviceSessionTtlHours": 24,
    "proofSigningInput": "bauman-device:v1:<deviceId>:<challengeId>:<challenge>",
    "challengeSingleUse": true,
    "blockedDeviceSessionsRevoked": true
  },
  "localRuntime": {
    "config": "control-service/wrangler.local.jsonc",
    "databaseName": "bauman-control-local",
    "productionDataIsolated": true
  },
  "subclients": [
    { "id": "math", "name": "Toán Bauman", "kind": "subject-site", "repository": "BlueDragon33/Math_Bauman", "state": "independent" },
    { "id": "programming", "name": "Lập trình", "kind": "module", "sourcePath": "subjects/programming", "state": "module" },
    { "id": "ai", "name": "AI", "kind": "module", "sourcePath": "subjects/ai", "state": "module" },
    { "id": "signal", "name": "Tín hiệu", "kind": "module", "sourcePath": "subjects/signal", "state": "module" },
    { "id": "systems", "name": "Hệ thống", "kind": "module", "sourcePath": "subjects/systems", "state": "module" },
    { "id": "foundation", "name": "Nền tảng", "kind": "module", "sourcePath": "subjects/foundation", "state": "module" },
    { "id": "research", "name": "Nghiên cứu", "kind": "module", "sourcePath": "subjects/research", "state": "module" },
    { "id": "russian", "name": "Tiếng Nga", "kind": "module", "sourcePath": "subjects/russian", "state": "module" }
  ],
  "policy": {
    "applicationManagementMayOpenLearningRuntimeDirectly": false,
    "applicationManagementMayInventOperationsWithoutBackend": false,
    "subclientsRemainUnderBaumanUntilIndependentContractExists": true,
    "centralMayEnableDeviceMutationOnlyAfterLiveCapabilityProbe": true,
    "learningRuntimeMustNotBeClaimedProtectedUntilAccessGateExists": true
  }
}
