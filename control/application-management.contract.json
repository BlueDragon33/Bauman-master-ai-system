{
  "contractVersion": 7,
  "application": {
    "id": "bauman-master-ai",
    "name": "Bauman Master AI",
    "tier": "client",
    "repository": "BlueDragon33/Bauman-master-ai-system"
  },
  "boundary": {
    "independentRuntime": true,
    "embeddedInApplicationManagement": false,
    "sharedDatabaseWithApplicationManagement": false,
    "sharedDeviceRegistryWithOtherClients": false,
    "learningRuntimeSeparatedFromControlService": true
  },
  "readiness": {
    "runtime": "available",
    "subclientInventory": "available",
    "readOnlyControlApi": "available",
    "deviceRegistry": "implemented-requires-d1",
    "deviceGateway": "implemented-requires-d1-and-app-origin",
    "mutationAdminApi": "implemented-requires-d1",
    "auditApi": "implemented-requires-d1",
    "p256ChallengeProof": "implemented-requires-d1-and-app-origin",
    "revocableDeviceSessions": "implemented-requires-d1-and-app-origin",
    "learningAccessGate": "implemented-e2e-verified-requires-d1-and-app-origin",
    "contentReviewApi": "implemented-requires-d1",
    "deviceMetadata": "implemented-requires-d1",
    "deviceUnblock": "implemented-requires-d1",
    "deviceEditPermission": "implemented-requires-d1",
    "serverSideLearningDataGate": "implemented-runtime-worker-live-session-validation"
  },
  "controlService": {
    "location": "control-service/",
    "protocol": "bauman-control-v4",
    "audience": "bauman-control",
    "routes": [
      "/health",
      "/api/control/status",
      "/api/control/subclients",
      "/api/control/devices",
      "/api/control/device-commands",
      "/api/control/content-reviews",
      "/api/control/content-review-commands",
      "/api/control/audit",
      "/api/device/register",
      "/api/device/challenge",
      "/api/device/verify",
      "/api/device/heartbeat",
      "/api/device/status"
    ],
    "mutationsEnabled": "runtime-gated-by-d1",
    "commandSemantics": {
      "idempotencyKey": "commandId",
      "optimisticConcurrency": "expectedStatus",
      "blockPreservesRegistry": true,
      "blockRevokesDeviceSessions": true,
      "ownerOnlyMutations": true,
      "operations": [
        "approve",
        "block",
        "unblock",
        "set_edit_permission"
      ]
    }
  },
  "requiredDeviceContract": {
    "namespace": "BM-",
    "identity": "sha256-canonical-p256-public-key",
    "classes": [
      "desktop",
      "tablet",
      "phone",
      "unknown"
    ],
    "accessAndEditSeparated": true,
    "privateKeyLocation": "endpoint-only",
    "challengeTtlSeconds": 120,
    "deviceSessionTtlHours": 24,
    "proofSigningInput": "bauman-device:v1:<deviceId>:<challengeId>:<challenge>",
    "challengeSingleUse": true,
    "blockedDeviceSessionsRevoked": true,
    "offlineGraceMilliseconds": 86400000,
    "displayCodeFormat": "BM-xxxx-xxxx-xxxx-xxxx",
    "metadata": [
      "deviceType",
      "platform",
      "browser"
    ],
    "serverSideLearningDataGate": true,
    "blockedDeviceCannotReadProtectedLearningAssets": true
  },
  "localRuntime": {
    "controlConfig": "control-service/wrangler.local.jsonc",
    "controlDatabaseName": "bauman-control-local",
    "controlPort": 3003,
    "learningRuntimePort": 3005,
    "productionDataIsolated": true
  },
  "cloudflarePreview": {
    "manualOnly": true,
    "workflow": ".github/workflows/deploy-bauman-preview.yml",
    "controlWorker": "bauman-control-preview",
    "controlDatabase": "bauman-control-preview-db",
    "learningWorker": "bauman-master-ai-preview",
    "productionDataIsolated": true,
    "chatgptSitesFallbackAllowed": false,
    "applicationManagementRemainsCanonical": true
  },
  "subclients": [
    {
      "id": "math",
      "name": "Toán Bauman",
      "kind": "subject-site",
      "repository": "BlueDragon33/Math_Bauman",
      "state": "independent"
    },
    {
      "id": "programming",
      "name": "Lập trình",
      "kind": "module",
      "sourcePath": "subjects/programming",
      "state": "module"
    },
    {
      "id": "ai",
      "name": "AI",
      "kind": "module",
      "sourcePath": "subjects/ai",
      "state": "module"
    },
    {
      "id": "signal",
      "name": "Tín hiệu",
      "kind": "module",
      "sourcePath": "subjects/signal",
      "state": "module"
    },
    {
      "id": "systems",
      "name": "Hệ thống",
      "kind": "module",
      "sourcePath": "subjects/systems",
      "state": "module"
    },
    {
      "id": "foundation",
      "name": "Nền tảng",
      "kind": "module",
      "sourcePath": "subjects/foundation",
      "state": "module"
    },
    {
      "id": "research",
      "name": "Nghiên cứu",
      "kind": "module",
      "sourcePath": "subjects/research",
      "state": "module"
    },
    {
      "id": "russian",
      "name": "Tiếng Nga",
      "kind": "module",
      "sourcePath": "subjects/russian",
      "state": "module"
    }
  ],
  "policy": {
    "applicationManagementMayOpenLearningRuntimeDirectly": false,
    "applicationManagementMayInventOperationsWithoutBackend": false,
    "subclientsRemainUnderBaumanUntilIndependentContractExists": true,
    "centralMayEnableDeviceMutationOnlyAfterLiveCapabilityProbe": true,
    "centralMayClaimLearningGateOnlyAfterLiveCapabilityProbe": true,
    "productionDeployRequiresExplicitPromotionAfterPreview": true,
    "applicationManagementMayEditLearningContent": false,
    "contentReviewStoresLearningContent": false,
    "contentReviewPublishRequiresPublisherOrOwner": true
  },
  "contentReview": {
    "owner": "Bauman-master-ai-system",
    "metadataOnly": true,
    "learningContentStoredInControlDatabase": false,
    "immutableReferenceFields": [
      "subjectId",
      "resourceType",
      "resourceId",
      "revision",
      "contentHash",
      "sourcePath"
    ],
    "statuses": [
      "pending",
      "approved",
      "rejected",
      "published"
    ],
    "submissionRoles": [
      "publisher",
      "owner"
    ],
    "readRoles": [
      "reviewer",
      "publisher",
      "owner"
    ],
    "operations": {
      "approve": {
        "roles": [
          "reviewer",
          "publisher",
          "owner"
        ],
        "expectedStatus": "pending",
        "resultStatus": "approved"
      },
      "reject": {
        "roles": [
          "reviewer",
          "publisher",
          "owner"
        ],
        "expectedStatus": "pending",
        "resultStatus": "rejected"
      },
      "publish": {
        "roles": [
          "publisher",
          "owner"
        ],
        "expectedStatus": "approved",
        "resultStatus": "published"
      }
    },
    "commandSemantics": {
      "idempotencyKey": "commandId",
      "optimisticConcurrency": "expectedStatus",
      "blindReplayForbidden": true
    },
    "auditActions": [
      "content_review_submitted",
      "content_review_approved",
      "content_review_rejected",
      "content_review_published"
    ]
  }
}
