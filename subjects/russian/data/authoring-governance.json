      "approved",
      "rejected",
      "published"
    ],
    "publishedMeaning": "review metadata published; canonical repository truth requires repo patch/merge"
  },
  "lifecycle": {
    "candidateStates": [
      "DRAFT",
      "VALIDATED",
      "REVIEW_REQUESTED",
      "APPROVED",
      "CANONICAL_PATCHED",
      "PUBLISHED",
      "REJECTED",
      "SUPERSEDED",
      "ARCHIVED"
    ],
    "promotionOrder": [
      "DRAFT",
      "VALIDATED",
      "REVIEW_REQUESTED",
      "APPROVED",
      "CANONICAL_PATCHED",
      "PUBLISHED"
    ],
    "noStateSkipping": true,
    "publishedRequiresCanonicalPatch": true
  },
  "canonicalWrites": {
    "candidate": false,
    "bulkImport": false,
    "generatedContent": false,
    "reviewService": false,
    "repositoryPatch": true
  },
