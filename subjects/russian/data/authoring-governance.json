{
  "schema": "RUSSIAN_RU08_AUTHORING_GOVERNANCE_V1",
  "phase": "RU08",
  "goldenRule": "ONE FACT · ONE OWNER · MANY USES",
  "canonicalOwnerRegistry": "subjects/russian/docs/ru02/RUSSIAN_RU02_CANONICAL_OWNER_REGISTRY.json",
  "linguisticAuthority": "subjects/russian/data/provenance.json",
  "learningJudgment": "subjects/russian/docs/ru04/RUSSIAN_RU04_LEARNING_JUDGMENT_CONTRACT.json",
  "reviewService": {
    "owner": "control-service",
    "storageMode": "METADATA_ONLY",
    "storesLearningContent": false,
    "publishedMeaning": "REVIEW_METADATA_STATUS_ONLY; canonical truth changes only through reviewed repository patch + release"
  },
  "lifecycle": {
    "candidateStates": [
      "DRAFT",
      "VALIDATED",
      "REVIEW_REQUESTED",
      "APPROVED",
      "CANONICAL_PATCHED",
      "PUBLISHED",
      "SUPERSEDED",
      "ARCHIVED",
      "REJECTED"
    ],
    "promotionOrder": [
      "DRAFT",
      "VALIDATED",
      "REVIEW_REQUESTED",
      "APPROVED",
      "CANONICAL_PATCHED",
      "PUBLISHED"
    ],
    "noStateSkipping": true,
    "publishedMeaningChangeRequiresNewRevision": true
  },
  "permissions": {
    "candidateMayWriteCanonical": false,
    "bulkImportMayWriteCanonical": false,
    "generatedContentMayWriteCanonical": false,
    "reviewServiceMayWriteCanonical": false,
    "repoPatchMayWriteCanonical": true
  },
  "authorableEntityTypes": [
    "Stage",
    "MacroModule",
    "Unit",
    "MicroLesson",
    "GrammarConcept",
    "LexicalEntry",
    "SpeakingItem",
    "DialogueScenario",
    "DeepSpeakingTask",
    "ReadingText",
    "WritingTask",
    "TechnicalConcept",
    "AcademicFunction",
    "Exercise",
    "AssessmentItem",
    "PerformanceTask",
    "MediaAsset",
    "ProvenanceRecord"
  ],
  "plannedEntityTypes": [
    "Competency",
    "LinguisticFunction",
    "PhoneticConcept",
    "PhraseCollocation",
    "ListeningItem",
    "ErrorPattern",
    "RemediationPath"
  ],
  "validation": {
    "requireCanonicalEntityType": true,
    "requireCanonicalOwnerPath": true,
    "requireCanonicalId": true,
    "requireRevision": true,
    "requireContentHash": true,
    "requireSourceRefsForCanonicalPromotion": true,
    "requireReviewerForApproval": true,
    "requireRollbackNote": true,
    "requireDiffSummary": true,
    "generatedPromotionRequires": [
      "VERIFIED",
      "VERIFIED_WITH_VARIANTS"
    ]
  },
  "bulk": {
    "mode": "STAGING_ONLY",
    "maxBatchItems": 500,
    "atomicCanonicalOverwrite": false,
    "eachItemValidatedIndependently": true
  },
  "ordinaryAuthoring": {
    "defaultSurface": "subjects/russian/editor.html",
    "rawJsonDefault": false,
    "canonicalWriteFromBrowser": false
  }
}
