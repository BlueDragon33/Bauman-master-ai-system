{
  "schema": "RUSSIAN_AI_MENTOR_POLICY_V2",
  "phase": "RU07",
  "legacySourceResponsibility": "P10",
  "authority": {
    "canonicalTruthOwner": "RU03",
    "assessmentMasteryOwner": "RU04",
    "plannerSrsOwner": "RU04",
    "speechAudioScenarioOwner": "RU05",
    "academicResearchProductionOwner": "RU06",
    "authoringPromotionOwner": "RU08",
    "aiRole": "NON_AUTHORITATIVE_COACH"
  },
  "permissions": {
    "readCanonicalContext": true,
    "explain": true,
    "suggest": true,
    "askSocraticQuestions": true,
    "generateTemporaryPractice": true,
    "generateCanonicalContent": false,
    "writeMastery": false,
    "writeAttemptHistory": false,
    "writeSrs": false,
    "writePlanner": false,
    "unlockStage": false,
    "silentlyPersistGeneratedPractice": false
  },
  "generatedPractice": {
    "lifecycle": "EPHEMERAL_UNTIL_RU08_REVIEW",
    "requiredLabels": [
      "generated",
      "non-canonical"
    ],
    "mayReferenceCanonicalIds": true,
    "mayInventSourceCitations": false,
    "promotionPath": "RU08_AUTHORING_REVIEW_GOVERNANCE"
  },
  "sourceBoundary": {
    "canonicalClaimsRequire": [
      "canonical-id-or-approved-source-ref"
    ],
    "ifUncertain": "STATE_UNCERTAINTY_AND_RESTRICT_TO_COACHING",
    "noFabricatedCitations": true,
    "noImplicitAuthorityFromModelOutput": true,
    "truthContract": "subjects/russian/docs/ru03/RU05_RU06_RU07_TRUTH_CONTRACT.json"
  },
  "contextPolicy": {
    "minimumNecessaryOnly": true,
    "requiresTrustMetadataForAuthoritativeLookingFeedback": true,
    "fullLearnerHistoryByDefault": false,
    "wholeDatasetDumpByDefault": false,
    "conversationSummaryIsCanonicalTruth": false
  },
  "coachingModes": [
    "explain",
    "hint",
    "socratic",
    "worked-example",
    "contrastive-feedback",
    "retrieval-prompt",
    "role-prep",
    "research-questioning"
  ],
  "forbiddenModes": [
    "auto-grade-official",
    "auto-master",
    "auto-unlock",
    "silent-state-write",
    "canonical-content-overwrite"
  ],
  "languagePolicy": {
    "supported": [
      "vi",
      "ru",
      "en",
      "vi-ru",
      "en-ru",
      "vi-en"
    ],
    "defaultExplanation": "vi",
    "targetLanguagePriority": "ru",
    "preserveTechnicalTerms": true,
    "doNotTranslateWhenTaskTestsRecognition": true
  }
}
