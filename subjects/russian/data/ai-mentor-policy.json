{
  "schema": "RUSSIAN_AI_MENTOR_POLICY_V1",
  "phase": "RU07",
  "authority": {
    "canonicalTruthOwner": "RU03",
    "assessmentMasteryOwner": "RU04",
    "plannerSrsOwner": "RU04",
    "speechAudioOwner": "RU05",
    "academicTechnicalOwner": "RU06",
    "authoringPromotionOwner": "RU08",
    "aiRole": "NON_AUTHORITATIVE_COACH"
  },
  "permissions": {
    "readCanonicalContext": true,
    "explain": true,
    "suggest": true,
    "askSocraticQuestions": true,
    "generateTemporaryPractice": true,
    "generateCanonicalContent": false,
    "writeMastery": false,
    "writeAttemptHistory": false,
    "writeSrs": false,
    "writePlanner": false,
    "unlockStage": false,
    "silentlyPersistGeneratedPractice": false
  },
  "generatedPractice": {
    "lifecycle": "EPHEMERAL_UNTIL_REVIEWED",
    "requiredLabels": [
      "generated",
      "non-canonical"
    ],
    "mayReferenceCanonicalIds": true,
    "mayInventSourceCitations": false,
    "promotionPath": "RU08_REVIEWED_REPOSITORY_PATCH"
  },
  "sourceBoundary": {
    "canonicalClaimsRequire": [
      "canonical-id-or-approved-source-ref"
    ],
    "ifUncertain": "STATE_UNCERTAINTY_AND_REQUEST_SOURCE",
    "noFabricatedCitations": true,
    "noImplicitAuthorityFromModelOutput": true
  },
  "coachingModes": [
    "explain",
    "hint",
    "socratic",
    "worked-example",
    "contrastive-feedback",
    "retrieval-prompt",
    "role-prep",
    "research-questioning"
  ],
  "forbiddenModes": [
    "auto-grade-official",
    "auto-master",
    "auto-unlock",
    "silent-state-write",
    "canonical-content-overwrite"
  ],
  "languagePolicy": {
    "supported": [
      "vi",
      "ru",
      "en",
      "vi-ru",
      "en-ru",
      "vi-en"
    ],
    "defaultExplanation": "vi",
    "targetLanguagePriority": "ru",
    "preserveTechnicalTerms": true,
    "doNotTranslateWhenTaskTestsRecognition": true
  },
  "runtimeReality": {
    "activeMode": "DETERMINISTIC_LOCAL_FALLBACK",
    "providerRequired": false,
    "providerHookStatus": "NOT_CONFIGURED",
    "claim": "The current learner-facing mentor is a deterministic local coaching fallback. No external-model behavior is claimed until a provider adapter is configured and passes RU07 executable security tests.",
    "stateBoundary": "may persist non-authoritative UI draft/output only; may not write mastery, official attempts, SRS, planner, stage unlocks or canonical content"
  }
}
