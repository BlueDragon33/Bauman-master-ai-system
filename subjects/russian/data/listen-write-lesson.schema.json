{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RUSSIAN_LISTEN_WRITE_LESSON_V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","id","lessonId","stage","level","title","items"],
  "properties": {
    "schema": {"const": "RUSSIAN_LISTEN_WRITE_LESSON_V1"},
    "id": {"type":"string","pattern":"^LW_[A-Z0-9_:-]+$"},
    "lessonId": {"type":"string","minLength":1},
    "stage": {"enum":["vn","prep","hk1","hk2","hk3","hk4"]},
    "level": {"enum":["A0","A1","A2","B1","B2","C1"]},
    "title": {"type":"string","minLength":1},
    "items": {
      "type":"array","minItems":1,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["id","contentType","handwritingSample","drills"],
        "properties":{
          "id":{"type":"string","pattern":"^LW_ITEM_[A-Z0-9_:-]+$"},
          "contentType":{"enum":["letter","syllable","word","phrase","sentence","dictation"]},
          "printSample":{"type":["string","null"]},
          "handwritingSample":{"type":"string","minLength":1},
          "drills":{
            "type":"array","minItems":1,
            "items":{
              "type":"object","additionalProperties":false,
              "required":["kind","audioText","answer","choices","hint","stress"],
              "properties":{
                "kind":{"enum":["hear_select","hear_trace","hear_write","syllable_write","word_dictation","stress_mark","sound_spelling_discrimination"]},
                "audioText":{"type":"string","minLength":1},
                "answer":{"type":"string","minLength":1},
                "choices":{"type":"array","items":{"type":"string","minLength":1}},
                "hint":{"type":["string","null"]},
                "stress":{"type":["string","null"]}
              }
            }
          }
        }
      }
    }
  }
}
