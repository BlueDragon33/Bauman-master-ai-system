{
  "schema": "RUSSIAN_VISUAL_VOCABULARY_CONTRACT_V1",
  "contractVersion": 1,
  "scope": "learner_facing_vocabulary_semantics",
  "authority": {
    "target": "direct_semantic_descriptor",
    "currentRuntimeAuthority": "legacy_core_until_turn_13",
    "authoritySwitch": false,
    "authoritySwitchTurn": 13
  },
  "russianIdentity": {
    "required": [
      "term_ru"
    ],
    "optional": [
      "pronunciation",
      "audio_cue",
      "example_ru",
      "context_ru"
    ]
  },
  "semanticChannels": {
    "allowed": [
      "image",
      "illustration",
      "pictogram",
      "emoji",
      "scene",
      "gesture",
      "object_relation",
      "contrast",
      "category_examples",
      "audio_context",
      "simple_russian_definition"
    ],
    "preferredOrder": [
      "image",
      "illustration",
      "scene",
      "pictogram",
      "gesture",
      "object_relation",
      "contrast",
      "category_examples",
      "audio_context",
      "simple_russian_definition"
    ],
    "minimumDirectChannels": 1
  },
  "learnerFacingProhibitedAnswerFields": [
    "meaning_vi",
    "vi_vi",
    "translation_vi",
    "gloss_vi",
    "definition_vi",
    "vi",
    "clue_en",
    "meaning_en",
    "translation_en",
    "definition_en",
    "en"
  ],
  "legacyCompatibility": {
    "sourceFieldsMayRemain": true,
    "legacyTranslationAuthority": "migration_and_authoring_diagnostics_only",
    "deletionRequiredAtThisTurn": false
  },
  "missingSemanticEvidence": {
    "status": "missing_visual_semantics",
    "explicitStateRequired": true,
    "fallbackToVietnamese": false,
    "fallbackToEnglish": false,
    "fallbackToUnverifiedGeneratedMeaning": false
  },
  "descriptor": {
    "schema": "RUSSIAN_VISUAL_SEMANTIC_DESCRIPTOR_V1",
    "required": [
      "term_ru",
      "semantic_status",
      "channels",
      "audio_or_pronunciation",
      "context"
    ],
    "semanticStatus": [
      "ready",
      "partial",
      "missing_visual_semantics"
    ]
  },
  "invariants": {
    "translationIsNotMeaningAuthority": true,
    "englishIsNotDefaultBridge": true,
    "audioDoesNotReplaceVisualMeaningByItself": true,
    "learnerStateAuthority": false,
    "masteryMutation": false
  }
}
