    "vertexIdentityDistinctFromDisplayLabel": true,
    "directionExplicit": true,
    "weightSemanticsExplicit": true,
    "representationExplicitForComplexity": true,
    "tieBreakingExplicitWhenRequired": true
  },
  "mutationSemantics": {
    "inPlaceMustBeExplicit": true,
    "operationMutationMustBeExplicit": true
  },
  "runtimeMutationAuthorized": false
