      "examples": [
        "моя комната",
        "моё окно",
        "мой кактус",
        "мой стол",
        "моя лампа",
        "мой ноутбук",
        "мой попугай",
        "моя собака"
      ],
      "representationPlan": ["room_scene", "text", "object_hotspots", "retrieval"]
    }
