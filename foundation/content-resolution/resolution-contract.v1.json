{
  "schema": "BAUMAN_CONTENT_RESOLUTION_CONTRACT_V1",
  "contractVersion": 1,
  "architectureName": "Foundation — Content Resolution & Runtime Delivery",
  "status": "foundation_contract",
  "dependency": {
    "registrySchema": "BAUMAN_CONTENT_ASSET_PROVENANCE_REGISTRY_V1",
    "registryRuntimeSchema": "BAUMAN_CONTENT_ASSET_REGISTRY_RUNTIME_V1",
    "snapshotSchema": "BAUMAN_CONTENT_ASSET_REGISTRY_SNAPSHOT_V1",
    "accessPolicySchema": "BAUMAN_ACCESS_POLICY_V1",
    "assetIntegritySchema": "BAUMAN_ASSET_INTEGRITY_V1",
    "mustNotMutateRegistry": true
  },
  "compatibility": {
    "strategy": "additive",
    "runtimeMigration": "none",
    "legacyLoadersPreserved": true,
    "learnerStateUntouched": true,
    "subjectRoutesUntouched": true,
    "browserStorageBinding": "none",
    "networkFetchInCore": false
  },
  "resolutionModes": {
    "learner_runtime": {
      "allowedAssetStates": [
        "verified",
        "active"
      ],
      "allowSuperseded": false,
      "requireAccessDecision": true,
      "requireChecksumReference": true
    },
    "audit_historical": {
      "allowedAssetStates": [
        "verified",
        "active",
        "superseded"
      ],
      "allowSuperseded": true,
      "requireAccessDecision": true,
      "requireChecksumReference": true
    }
  },
  "locatorKinds": {
    "repository_relative": {
      "transport": "package_relative",
      "directlyResolvable": true,
      "rules": {
        "separator": "/",
        "absolutePathForbidden": true,
        "parentTraversalForbidden": true,
        "driveLetterForbidden": true,
        "queryFragmentForbidden": true
      }
    },
    "https_url": {
      "transport": "https",
      "directlyResolvable": true,
      "rules": {
        "httpsOnly": true,
        "networkPolicyRequired": true
      }
    },
    "content_hash": {
      "transport": "content_addressed_provider",
      "directlyResolvable": false,
      "rules": {
        "format": "sha256:<64 lowercase hex>",
        "providerRequired": true
      }
    }
  },
  "blockedAssetStates": [
    "staged",
    "quarantined",
    "missing"
  ],
  "requiredInput": {
    "targetRecordTypes": [
      "asset",
      "content"
    ],
    "fields": [
      "targetRegistryId",
      "mode",
      "accessContext",
      "runtimePolicy"
    ]
  },
  "runtimePolicy": {
    "fields": [
      "allowRepositoryRelative",
      "allowHttps",
      "availableProviders",
      "allowedHttpsOrigins"
    ],
    "defaultNetwork": "deny",
    "providerNames": [
      "content_hash"
    ],
    "httpsOriginPolicy": {
      "requiredWhenHttpsEnabled": true,
      "exactOriginMatch": true,
      "wildcardOriginsForbidden": true,
      "nonHttpsOriginsForbidden": true,
      "emptyAllowlistMeansDeny": true
    }
  },
  "output": {
    "schema": "BAUMAN_RUNTIME_RESOURCE_DESCRIPTOR_V1",
    "statuses": [
      "resolved",
      "blocked",
      "provider_required",
      "not_found",
      "ambiguous"
    ],
    "resolvedRequired": [
      "schema",
      "status",
      "targetRegistryId",
      "assetRegistryId",
      "canonicalEntityId",
      "mediaType",
      "assetType",
      "checksumId",
      "locator",
      "transport",
      "mode",
      "access"
    ],
    "blockedRequired": [
      "schema",
      "status",
      "targetRegistryId",
      "reason",
      "mode"
    ],
    "rules": {
      "immutable": true,
      "registryReadOnly": true,
      "noImplicitFallbackToDisplayName": true,
      "noImplicitFilesystemGuess": true,
      "noImplicitNetworkEnable": true
    }
  },
  "forbiddenAuthority": [
    "learner_state",
    "mastery",
    "review_queue",
    "srs",
    "schedule",
    "subject_route",
    "authentication",
    "network_credentials",
    "registry_mutation"
  ],
  "accessEvaluation": {
    "source": "BAUMAN_ACCESS_POLICY_V1",
    "resolverMustEvaluateTarget": true,
    "resolverMustEvaluateResolvedAsset": true,
    "externalDecisionTrusted": false,
    "failClosed": true
  },
  "selectionPolicy": {
    "locatorPrecedence": [
      "repository_relative",
      "content_hash",
      "https_url"
    ],
    "preferredAssetIdOptional": true,
    "preferredAssetIdMustBeLinkedToContent": true,
    "multipleViableAssetsWithoutPreference": "ambiguous",
    "noDisplayNameSelection": true
  }
}
