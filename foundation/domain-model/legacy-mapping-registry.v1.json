      "storageKey": "bauman_russian_academic_language_v1",
      "legacySchema": "RUSSIAN_ACADEMIC_LANGUAGE_V1",
      "scopeRules": [
        {"scope": "grammar", "kind": "knowledge", "localPrefix": "grammar"},
