{
  "schema": "BAUMAN_LEGACY_MAPPING_REGISTRY_V1",
  "registryVersion": 1,
  "domainContract": "BAUMAN_DOMAIN_CONTRACT_V1",
  "overlaySchema": "BAUMAN_IDENTITY_OVERLAY_V1",
  "policy": {
    "mode": "overlay",
    "legacyDataAuthoritative": true,
    "rewriteLegacyIds": false,
    "rewriteLegacyStorage": false,
    "runtimeStorageWritesAllowed": false,
    "mappingMustBeDeterministic": true,
    "mappingMustBeIdempotent": true,
    "unknownOverlayFieldsPreserved": true
  },
  "persistence": {
    "storeSchema": "BAUMAN_IDENTITY_OVERLAY_STORE_V1",
    "storageKey": "bauman_identity_overlay_v1",
    "stagingKey": "bauman_identity_overlay_v1_staging",
    "legacyKeysNeverWritten": true,
    "stagingRequired": true,
    "readBackVerificationRequired": true,
    "recoveryFromValidStagingAllowed": true,
    "browserPersistenceMode": "verified_overlay_only",
    "browserAutoCommitAllowed": true,
    "corruptOverlayAutoRepairAllowed": false,
    "idempotentNoRewriteRequired": true
  },
  "systems": [
    {
      "systemId": "russian-core-state",
      "namespace": "russian-core",
      "storageKey": "bauman_russian_survival_master_v11_clean_skeleton",
      "legacySchema": null,
      "scopeRules": [
        {"scope": "state", "kind": "workflow", "localPrefix": "state"},
        {"scope": "route", "kind": "task", "localPrefix": "route"}
      ]
    },
    {
      "systemId": "russian-learning-state",
      "namespace": "russian-learning",
      "storageKey": "bauman_russian_learning_state_v1",
      "legacySchema": "RUSSIAN_LEARNING_STATE_V1",
      "scopeRules": [
        {"scope": "item", "kind": "task", "localPrefix": "item"},
        {"scope": "review", "kind": "task", "localPrefix": "review"},
        {"scope": "resume", "kind": "workflow", "localPrefix": "resume"}
      ]
    },
    {
      "systemId": "russian-learning-flow",
      "namespace": "russian-flow",
      "storageKey": "bauman_russian_learning_flow_v1",
      "legacySchema": "RUSSIAN_LEARNING_FLOW_V1",
      "scopeRules": [
        {"scope": "lesson", "kind": "knowledge", "localPrefix": "lesson"},
        {"scope": "step", "kind": "task", "localPrefix": "step"}
      ]
    },
    {
      "systemId": "russian-vocab-srs",
      "namespace": "russian-vocab",
      "storageKey": "bauman_russian_vocab_srs_v1",
