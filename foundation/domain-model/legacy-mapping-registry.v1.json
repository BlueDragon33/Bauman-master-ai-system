      "scopeRules": [
        {"scope": "subject", "kind": "knowledge", "localPrefix": "subject"},
        {"scope": "course", "kind": "workflow", "localPrefix": "course"},
        {"scope": "task", "kind": "task", "localPrefix": "task"},
        {"scope": "mission", "kind": "workflow", "localPrefix": "mission"}
