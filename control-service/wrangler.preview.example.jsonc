{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bauman-control-preview",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APPLICATION_MANAGEMENT_ORIGIN": "__APPLICATION_MANAGEMENT_PREVIEW_ORIGIN__",
    "BAUMAN_APP_ORIGIN": "__BAUMAN_RUNTIME_PREVIEW_ORIGIN__",
    "BAUMAN_DEPLOYMENT_CHANNEL": "cloudflare-preview",
    "BAUMAN_BUILD_REVISION": "__BAUMAN_BUILD_REVISION__"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bauman-control-preview-db",
      "database_id": "__BAUMAN_CONTROL_PREVIEW_D1_DATABASE_ID__",
      "migrations_dir": "migrations"
    }
  ]
}
