{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bauman-master-ai",
  "main": "cloudflare/runtime-worker.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "BAUMAN_CONTROL_ORIGIN": "__BAUMAN_CONTROL_PRODUCTION_ORIGIN__",
    "BAUMAN_DEPLOYMENT_CHANNEL": "cloudflare-production",
    "BAUMAN_BUILD_REVISION": "__BAUMAN_BUILD_REVISION__"
  },
  "assets": {
    "directory": "./runtime-dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
