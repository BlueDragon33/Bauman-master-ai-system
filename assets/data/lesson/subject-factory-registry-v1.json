    {
      "id": "LIGHT-MANIFEST-SIMULATION-GAP",
      "severity": "bounded",
      "finding": "The five light subject JSON manifests declare six data files while their runtimes load simulations.json as a seventh source.",
      "decision": "Register simulations as audited-runtime-supplemental in B9; do not rewrite the five working runtimes."
    },
    {
      "id": "FOUNDATION-MIXED-TYPE-GAP",
      "severity": "fail-closed",
      "finding": "Foundation contains language, mathematics, computing, entrepreneurship and legal/civic modules; the last two do not have a safe automatic mapping to the locked eight lesson types.",
      "decision": "Pilot only deterministically classified modules; return UNCLASSIFIED_LESSON for f_m201 and f_m202 until content/type review."
    },
    {
      "id": "MATH-AUTHORITATIVE-SOURCE-PRECEDENCE",
      "severity": "critical",
      "finding": "Math current theory uses an authoritative artifact/content reader while the large legacy lessons.json is a deferred compatibility source.",
      "decision": "Register theory_lecture_content and artifact-reader precedence; never choose legacy content by array index or preload the full legacy source."
    },
    {
      "id": "RUSSIAN-REQUIRED-LAZY-PERSISTENCE",
      "severity": "critical",
      "finding": "Russian vocab, tests and speaking are required sources deferred from startup without becoming persistence-excluded optional sources.",
      "decision": "Register them as required-lazy, separate from the three optional specialist sources."
    }
  ],
