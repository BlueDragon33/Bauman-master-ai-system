    "policy": "bauman-only"
  },
  "principles": [
    "Do not render empty pedagogical sections merely to satisfy the template.",
    "Preserve each subject's specialist interactions; the universal contract is a pedagogical spine, not a visual clone.",
    "A lesson is complete only when the learner produces mastery evidence, not when the page was viewed.",
    "Russian and English are embedded progressively by stage; Vietnamese remains a rescue layer when needed.",
    "AI may explain, diagnose and coach, but must not silently fabricate source-grounded academic content."
  ],
  "canonicalFlow": [
    "hook",
    "concept-map",
    "theory",
    "worked-example",
    "try-it-yourself",
    "graded-practice",
    "interactive-lab",
    "simulation",
    "common-mistakes",
    "visual-check",
    "russian-twin",
    "english-research",
    "ai-tutor",
    "oral-defense",
    "review",
    "assessment",
    "master-ready",
    "project-nir-checkpoint"
  ],
