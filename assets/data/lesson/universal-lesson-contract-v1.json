  "lessonProfiles": {
    "language": {
      "specialties": ["dialogue", "shadowing", "speech", "listening", "vocab-flashcard", "grammar", "handwriting", "writing"],
      "referenceSubject": "russian"
    },
    "math": {
      "specialties": ["math-typesetting", "derivation", "graph", "matrix-visualizer", "parameter-simulation", "professor-qa"],
      "referenceSubject": "math"
    },
    "programming": {
      "specialties": ["code-lab", "unit-test", "debug", "output-prediction", "repo-artifact", "oral-defense"],
      "referenceSubject": "programming"
    },
    "database": {
      "specialties": ["sql-playground", "schema-diagram", "query-plan", "transaction-scenario", "data-pipeline"]
    },
    "data-ml": {
      "specialties": ["dataset-playground", "metric-visualizer", "model-comparison", "confusion-matrix", "error-analysis", "experiment-log"]
    },
    "systems": {
      "specialties": ["architecture-diagram", "information-flow", "reliability-scenario", "lifecycle", "fault-analysis"]
    },
    "time-series": {
      "specialties": ["signal-plot", "decomposition", "forecast", "anomaly", "telemetry-lab"]
    },
    "research": {
      "specialties": ["literature-matrix", "research-question", "baseline", "experiment-protocol", "evidence-vault", "defense-simulator"]
    },
    "foundation": {
      "specialties": ["bridge-prerequisite", "diagnostic", "fast-recovery"]
    }
  },
  "languageImmersion": {
    "modes": ["VI_PRIMARY", "RU_GROWING", "RU_FIRST", "MASTER_RU_EN", "ADAPTIVE"],
    "stageDefaults": {
      "prepare": {"mode": "VI_PRIMARY", "vi": 0.85, "ru": 0.10, "en": 0.05},
      "preparatory-early": {"mode": "RU_GROWING", "vi": 0.60, "ru": 0.30, "en": 0.10},
      "preparatory-late": {"mode": "RU_FIRST", "vi": 0.30, "ru": 0.60, "en": 0.10},
      "master": {"mode": "MASTER_RU_EN", "vi": 0.10, "ru": 0.70, "en": 0.20}
    },
    "rules": [
      "Russian is the classroom/technical language target.",
      "English is primarily the documentation, paper and international terminology layer.",
      "Vietnamese is the comprehension/rescue layer and must not disappear abruptly.",
      "Subject-level adaptive ratios may differ from global defaults."
    ]
  },
  "aiContract": {
    "contextInputs": ["lesson", "prerequisites", "learner-progress", "assessment-errors", "weak-topics", "schedule", "current-bauman-subject", "language-level", "nir-vkr-context"],
    "outputTypes": ["explanation", "hint", "socratic-question", "diagnosis", "recovery-route", "oral-feedback", "review-recommendation"],
    "sourcePolicy": "For source-grounded or research claims, distinguish provided-source evidence from model inference and external research. Never invent citations.",
    "antiShortcut": "Default to hints/Socratic coaching on active exercises; reveal full worked solution only when lesson policy allows it."
  },
  "masteryPolicy": {
    "minimumAssessmentPercent": 80,
    "retentionWindowDays": [14, 21],
    "retentionTargetPercent": 75,
    "requiredEvidence": ["assessment-pass", "application-or-lab", "oral-explanation", "retention-check"],
    "statusVocabulary": ["Chưa học", "Đang học", "Đạt prerequisite", "Master-ready", "Cần ôn", "Gap"]
  },
  "offlinePolicy": {
    "appShellSeparateFromContent": true,
    "lazyHeavyData": true,
    "selectiveSubjectPacks": true,
    "localFileZeroCopySupported": true,
    "generativeAiRequiredOffline": false,
    "rule": "Offline mode must preserve deterministic learning, review, assessment, roadmap and previously downloaded/local material even when generative AI is unavailable."
  }
}
