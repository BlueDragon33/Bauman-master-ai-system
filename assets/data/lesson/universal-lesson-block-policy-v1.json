{
  "policyId": "bauman-universal-lesson-block-policy",
  "policyVersion": "1.0.0",
  "status": "L6-B3-POLICY",
  "contractRef": {
    "path": "assets/data/lesson/universal-lesson-contract-v2.json",
    "contractId": "bauman-universal-lesson-contract",
    "schemaVersion": "2.0.0"
  },
  "requirementStates": {
    "required": {
      "meaning": "The semantic capability must resolve to valid inline or external content before the lesson can satisfy its profile.",
      "emptyBehavior": "validation-error"
    },
    "optional": {
      "meaning": "Use the block only when useful source content or a specialist capability exists.",
      "emptyBehavior": "omit-without-placeholder"
    },
    "conditional": {
      "meaning": "The block becomes required only when its named condition evaluates true.",
      "falseBehavior": "omit-without-placeholder",
      "trueEmptyBehavior": "validation-error"
    },
    "forbidden": {
      "meaning": "The block is not allowed in the resolved lesson mode because it would leak, duplicate or misrepresent learning state.",
      "presentBehavior": "validation-error-and-quarantine"
    }
  },
  "fulfillmentModes": {
    "inline": {
      "meaning": "The universal projection supplies a payload."
    },
    "external": {
      "meaning": "A registered specialist engine or authoritative artifact supplies the semantic capability."
    },
    "either": {
      "meaning": "Inline payload or a registered specialist capability may satisfy the policy."
    }
  },
  "conditionCatalog": {
    "teaches-new-concept": {
      "scope": "lesson",
      "expression": "metadata.flags.teachesNewConcept === true",
      "reason": "Practice-only lessons need not manufacture a theory view."
    },
    "has-worked-procedure": {
      "scope": "lesson",
      "expression": "metadata.flags.hasWorkedProcedure === true || sourceBindings contain worked-example",
      "reason": "A worked example is required only when a model procedure exists."
    },
    "requires-interactive-manipulation": {
      "scope": "lesson",
      "expression": "metadata.flags.requiresInteractiveManipulation === true",
      "reason": "Labs and simulations are learning tools, not decorative mandatory widgets."
    },
    "has-diagnosable-visual-state": {
      "scope": "lesson",
      "expression": "metadata.flags.hasDiagnosableVisualState === true",
      "reason": "Visual checks are required when a meaningful correct/wrong or state comparison exists."
    },
    "requires-oral-performance": {
      "scope": "lesson",
      "expression": "metadata.flags.requiresOralPerformance === true",
      "reason": "Oral evidence is activated by language, seminar or defense policy."
    },
    "assessment-blueprint-present": {
      "scope": "lesson",
      "expression": "metadata.assessmentBlueprintRef is present",
      "reason": "The contract must not synthesize an official test from empty content."
    },
    "project-or-nir-link-present": {
      "scope": "lesson",
      "expression": "contextRefs.nirVkrContext or metadata.projectRef is present",
      "reason": "Project and research evidence appears only when the lesson has a traceable milestone."
    },
    "has-concept-relations": {
      "scope": "lesson",
      "expression": "prerequisites are populated || metadata.conceptGraphRef is present",
      "reason": "A concept map is useful only when relations exist."
    },
    "has-source-backed-misconceptions": {
      "scope": "lesson",
      "expression": "source bindings contain misconception or diagnostic records",
      "reason": "Do not invent common errors merely to satisfy a template."
    },
    "has-experiment-or-dataset": {
      "scope": "lesson",
      "expression": "metadata.experimentRef or metadata.datasetRef is present",
      "reason": "Research labs activate only for an actual experiment or dataset."
    },
    "post-diagnostic-repair-needed": {
      "scope": "learner-state",
      "expression": "assessmentErrors are non-empty || weakTopics are non-empty",
      "reason": "Recovery content appears after a diagnosed gap."
    }
  },
  "basePolicy": {
