  "resolutionAlgorithm": [
    "Load the base policy for all registered semantic block kinds.",
    "Apply the selected lesson-type overrides.",
    "Apply at most one lesson-mode overlay.",
    "Reject unknown block kinds, requirement states, fulfillment modes or condition refs.",
    "Evaluate forbidden rules before resolving content.",
    "Evaluate conditional rules against declared metadata and learner state.",
    "Resolve inline payload or registered specialist capabilities according to fulfillment mode.",
    "Omit empty optional and false conditional blocks without placeholders.",
    "Fail required or true conditional blocks that have no valid fulfillment.",
    "Pass the resolved semantic set to a presentation strategy; never convert policy rows directly into tabs."
  ],
  "presentationBehavior": {
    "createsTabs": false,
    "createsRoutes": false,
    "emptyOptionalPlaceholder": false,
    "rendererInput": "resolved-populated-semantic-blocks",
    "specialistOwnershipPreserved": true
  },
  "validationPolicy": {
    "allCatalogBlocksClassifiedAfterResolution": true,
    "unknownBlockPolicy": "error",
    "unknownConditionPolicy": "error",
    "requiredEmptyPolicy": "error",
    "conditionalTrueEmptyPolicy": "error",
    "forbiddenPresentPolicy": "error-and-quarantine",
    "optionalEmptyPolicy": "omit",
    "externalWithoutCapabilityPolicy": "error",
    "sourceMutationAllowed": false,
    "legacyStateKeyMutationAllowed": false
  }
