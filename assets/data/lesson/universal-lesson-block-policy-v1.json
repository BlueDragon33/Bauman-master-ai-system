    },
    "lab-simulation": {
      "requirement": "conditional",
      "fulfillment": "either",
      "conditionRef": "requires-interactive-manipulation"
    },
    "misconception": {
      "requirement": "conditional",
      "fulfillment": "either",
      "conditionRef": "has-source-backed-misconceptions"
    },
    "visual-check": {
      "requirement": "conditional",
      "fulfillment": "either",
      "conditionRef": "has-diagnosable-visual-state"
    },
    "oral": {
      "requirement": "conditional",
      "fulfillment": "either",
      "conditionRef": "requires-oral-performance"
    },
    "review": {
      "requirement": "required",
      "fulfillment": "either"
    },
    "assessment": {
