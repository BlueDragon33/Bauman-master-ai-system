{
  "policyId": "bauman-master-ready-policy",
  "policyVersion": "1.0.0",
  "status": "L6-B5-POLICY",
  "contractRef": {
    "path": "assets/data/lesson/universal-lesson-contract-v2.json",
    "contractId": "bauman-universal-lesson-contract",
    "schemaVersion": "2.0.0"
  },
  "typeRegistryRef": {
    "path": "assets/data/lesson/lesson-type-registry-v1.json",
    "registryId": "bauman-lesson-type-registry",
    "registryVersion": "1.0.0"
  },
  "policyPurpose": "Master-ready is verified retained competence, not page completion and not merely a course-grade pass.",
  "stageOrder": [
    "understand",
    "solve",
    "build-apply",
    "explain",
    "retain"
  ],
  "stageContract": {
    "understand": {
      "meaning": "Identify governing concepts, assumptions, vocabulary, boundaries and why the method applies.",
      "dependency": [],
      "minimumEvidenceEvents": 1
    },
    "solve": {
      "meaning": "Produce a correct constrained response, solution, procedure or method selection without protected-answer leakage.",
      "dependency": [
        "understand"
      ],
      "minimumEvidenceEvents": 1
    },
    "build-apply": {
      "meaning": "Create or apply a domain artifact in a realistic task and verify the result.",
      "dependency": [
        "understand",
        "solve"
      ],
      "minimumEvidenceEvents": 1
    },
    "explain": {
      "meaning": "Explain choices, assumptions, errors, limits and evidence in a type-appropriate oral or written defense.",
      "dependency": [
        "understand",
        "solve"
      ],
      "minimumEvidenceEvents": 1
    },
    "retain": {
      "meaning": "Reproduce essential competence after a delayed interval using a new or varied prompt.",
      "dependency": [
        "understand",
        "solve",
        "build-apply",
        "explain"
      ],
      "minimumEvidenceEvents": 1
    }
  },
  "evidenceEnvelope": {
    "requiredFields": [
      "evidenceId",
      "lessonId",
      "typeId",
      "stage",
      "evidenceKind",
      "artifactRefs",
      "sourceRefs",
      "learnerStateRef",
      "attemptRef",
      "createdAt",
      "verification",
      "provenance"
    ],
    "artifactRefRule": "Evidence may reference repository artifacts, Personal Learning State records, subject-engine records or zero-copy local files; the policy never embeds a private learner file.",
    "sourceRefRule": "Every scored claim keeps versioned source or task refs distinct from learner artifacts and AI inference.",
    "attemptRule": "Attempts are append-only. A repair event links prior evidence through supersedesRef but never deletes it.",
    "verificationRequiredFields": [
      "actorType",
      "method",
      "rubricProfileRef",
      "criterionScores",
      "status"
    ],
    "verificationStatuses": [
      "submitted",
      "verified",
      "needs-repair",
      "rejected",
      "advisory-only"
    ],
    "provenanceGroups": [
      "provided-source",
      "user-evidence",
      "system-derived",
      "ai-inference"
    ]
  },
  "verificationActors": {
    "deterministic-evaluator": {
      "maySetVerified": true,
      "allowedMethods": [
        "answer-key",
        "unit-test",
        "query-result",
        "schema-rule",
        "numeric-tolerance",
        "simulation-invariant",
        "artifact-validator"
      ]
    },
    "instructor-review": {
      "maySetVerified": true,
      "allowedMethods": [
        "rubric-review",
        "oral-defense",
        "artifact-review"
      ]
    },
    "learner-self-check": {
      "maySetVerified": false,
      "allowedMethods": [
        "reflection",
        "self-rating",
        "retrieval-log"
      ]
    },
    "peer-review": {
      "maySetVerified": false,
      "allowedMethods": [
        "rubric-comment",
        "artifact-comment"
      ]
    },
    "ai-advisory": {
      "maySetVerified": false,
      "allowedMethods": [
        "hint",
        "diagnosis",
        "rubric-suggestion",
        "oral-feedback",
        "recovery-route"
      ],
      "boundary": "AI output may support a verifier but cannot be the final verification authority or fabricate source-grounded evidence."
    }
  },
  "scoreContract": {
    "criterionScale": {
      "minimum": 0,
      "maximum": 4,
      "labels": {
        "0": "missing-or-invalid",
        "1": "major-gap",
        "2": "partial",
        "3": "competent",
        "4": "independent-and-robust"
      }
    },
    "normalizedFormula": "sum((criterionScore / 4) * criterionWeight)",
    "weightSum": 1,
    "criticalFailureRule": "Any critical criterion below its minimum blocks Master-ready regardless of total score.",
    "stageFailureRule": "Any stage below its type-specific minimum blocks Master-ready.",
    "prerequisiteRule": "Any unresolved required prerequisite blocks ready-for-retention and Master-ready while preserving orientation and recovery access.",
    "sourceIntegrityRule": "Evidence whose required source version is withdrawn, superseded incompatibly or fails integrity review moves to needs-repair.",
    "officialGradeBoundary": "Course pass and Master-ready are separate. An official course rule may add evidence or raise a gate but cannot silently lower Master-ready defaults."
  },
  "gateStateMachine": {
    "states": [
      "not-started",
      "learning",
      "ready-for-retention",
      "master-ready",
      "retention-due",
      "needs-repair"
    ],
    "transitions": [
      {
        "from": "not-started",
        "to": "learning",
        "when": "first valid learning or evidence event"
      },
      {
        "from": "learning",
        "to": "ready-for-retention",
        "when": "understand solve build-apply and explain pass, with retain not yet due"
      },
      {
        "from": "ready-for-retention",
        "to": "master-ready",
        "when": "required delayed retain windows and all rubric gates pass"
      },
      {
        "from": "ready-for-retention",
        "to": "needs-repair",
        "when": "required evidence or source integrity is invalidated before retention"
      },
      {
        "from": "master-ready",
        "to": "retention-due",
        "when": "the next profile retention window becomes due"
      },
      {
        "from": "master-ready",
        "to": "needs-repair",
        "when": "required evidence or source integrity is revoked"
      },
      {
        "from": "retention-due",
        "to": "master-ready",
        "when": "a varied delayed retain attempt passes"
      },
      {
        "from": "learning",
        "to": "needs-repair",
        "when": "a required stage or critical criterion fails"
      },
      {
        "from": "retention-due",
        "to": "needs-repair",
        "when": "the delayed retain attempt fails"
      },
      {
        "from": "needs-repair",
        "to": "learning",
        "when": "a source-linked repair route starts"
      }
    ],
    "invariants": [
      "ready-for-retention is provisional and is never displayed or exported as Master-ready.",
      "A page-view, route-open, scroll, elapsed-time or AI-chat event is never sufficient evidence.",
      "Master-ready requires all five stage gates, the profile total threshold and every critical minimum.",
      "Unresolved required prerequisites block ready-for-retention and Master-ready.",
      "Evidence remains tied to versioned sources; source invalidation creates an explicit repair transition.",
      "Retention uses a varied prompt and cannot reuse a memorized official assessment answer.",
      "State changes preserve prior attempts and repair links."
    ]
  },
  "rubricContract": {
    "requiredProfileFields": [
      "typeId",
      "totalThreshold",
