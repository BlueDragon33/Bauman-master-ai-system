    "courseLifecycleAxis": [
      {"id":"NOT_STARTED","meaning":"Official course/practice has not started."},
      {"id":"COURSE_ACTIVE","meaning":"Official course/practice is in progress."},
      {"id":"COMPLETED","meaning":"Official course/practice result has been recorded."}
    ],
