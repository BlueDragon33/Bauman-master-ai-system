{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bauman-python-runtime-ci",
  "main": "cloudflare/runtime-worker-python.mjs",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "BAUMAN_CONTROL_ORIGIN": "https://control.example.test",
    "BAUMAN_ACCESS_MODE": "standalone",
    "BAUMAN_DEPLOYMENT_CHANNEL": "python-p4-local-ci",
    "BAUMAN_BUILD_REVISION": "python-p4-local-ci",
    "BAUMAN_PYTHON_EXECUTION_ENABLED": "true",
    "BAUMAN_PYTHON_PROVIDER_TEST_MODE": "true",
    "BAUMAN_PYTHON_RUNTIME_PROFILE": "cpython-3.14.8-stdlib-v1",
    "BAUMAN_PYTHON_HIDDEN_TEST_SENTINEL": "BAUMAN_HIDDEN_TEST_SENTINEL_P4"
  },
  "containers": [
    {
      "class_name": "PythonSandbox",
      "scheduling_policy": "durable_object",
      "images": {
        "python": {
          "dockerfile": "./cloudflare/python-runtime/Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PYTHON_SANDBOX",
        "class_name": "PythonSandbox"
      }
    ]
  },
  "exports": {
    "PythonSandbox": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
