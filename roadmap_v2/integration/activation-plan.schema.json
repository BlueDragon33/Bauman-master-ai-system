    "planId": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["safe_noop", "blocked"] },
    "requestedFeatureFlags": { "type": "object" },
    "effectiveFeatureFlags": { "type": "object" },
    "reasonCodes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "rollback": { "type": "object" },
    "persisted": { "const": false },
    "runtimeWriteAllowed": { "const": false },
    "legacyMutationAllowed": { "const": false }
