{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "BAUMAN_ROADMAP_V2_DIAGNOSTIC_ITEM_BANK_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "bankId",
    "targetId",
    "policyId",
    "reviewStatus",
    "reviewedBy",
    "sourceProvenance",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "BAUMAN_ROADMAP_V2_DIAGNOSTIC_ITEM_BANK_V1"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "bankId": {
      "type": "string",
      "minLength": 1
    },
    "targetId": {
      "type": "string",
      "minLength": 1
    },
    "policyId": {
      "const": "DIAG-20-V1"
    },
    "reviewStatus": {
      "const": "verified"
    },
    "reviewedBy": {
      "type": "string",
      "minLength": 1
    },
    "sourceProvenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "items": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "targetId",
          "difficulty",
          "critical",
          "prompt",
          "options",
          "correctOptionId",
          "rationale",
          "prerequisiteRefs",
          "evidenceTags",
          "reviewStatus"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "targetId": {
            "type": "string",
            "minLength": 1
          },
          "difficulty": {
            "enum": [
              "easy",
              "medium",
              "hard",
              "expert"
            ]
          },
          "critical": {
            "type": "boolean"
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": [
                "id",
                "text"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "correctOptionId": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "prerequisiteRefs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidenceTags": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reviewStatus": {
            "const": "verified"
          }
        }
      }
    }
  }
}
