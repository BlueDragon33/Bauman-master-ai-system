{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "BAUMAN_ROADMAP_V2_PRODUCTION_READINESS_REVIEW_REQUEST_V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","candidateRef","productionReadinessReviewerRef","reviewDecision","reasonCodes","promotionReviewRequest"],
  "properties": {
    "schema": {"const": "BAUMAN_ROADMAP_V2_PRODUCTION_READINESS_REVIEW_REQUEST_V1"},
    "candidateRef": {"type": "string","pattern": "^CANDIDATE::[A-Z0-9_-]+$"},
    "productionReadinessReviewerRef": {"type": "string","pattern": "^PRODUCTION_READINESS_REVIEWER::[A-Z0-9_-]+$"},
    "reviewDecision": {"enum": ["approve_shadow_readiness","needs_revision","rejected"]},
    "reasonCodes": {"type": "array","minItems": 1,"maxItems": 12,"items": {"type": "string","pattern": "^[A-Z0-9_-]{1,64}$"}},
    "promotionReviewRequest": {
      "type": "object",
      "description": "Current BAUMAN_ROADMAP_V2_PROMOTION_REVIEW_REQUEST_V1; recomputed by the L33/L34 harness chain"
    }
  }
}