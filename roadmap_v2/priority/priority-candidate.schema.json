{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "BAUMAN_ROADMAP_V2_PRIORITY_CANDIDATE_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidateId",
    "targetId",
    "phaseId",
    "masterRelevance",
    "masterRelevanceSource",
    "weeksUntilNeeded",
    "snapshot"
  ],
  "properties": {
    "schema": {
      "const": "BAUMAN_ROADMAP_V2_PRIORITY_CANDIDATE_V1"
    },
    "candidateId": {
      "type": "string",
      "minLength": 1
    },
    "targetId": {
      "type": "string",
      "minLength": 1
    },
    "phaseId": {
      "enum": [
        "GD0",
        "GD1",
        "GD2",
        "GD3"
      ]
    },
    "masterRelevance": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "masterRelevanceSource": {
      "type": "string",
      "minLength": 1
    },
    "weeksUntilNeeded": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "snapshot": {
      "type": "object"
    }
  }
}
