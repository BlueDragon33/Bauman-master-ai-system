      "const": "BAUMAN_ROADMAP_V2_PRIORITY_RESULT_V1"
    },
    "candidateId": {
      "type": "string"
    },
    "targetId": {
      "type": "string"
    },
    "phaseId": {
      "type": "string"
    },
    "knowledgeState": {
      "type": "string"
    },
    "features": {
      "type": "object"
    },
    "contributions": {
      "type": "object"
    },
    "weightedScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "criticalOverride": {
      "type": "boolean"
    },
    "reviewOnDemand": {
      "type": "boolean"
    },
    "disposition": {
      "enum": [
        "critical",
        "review_on_demand",
        "high",
        "medium",
        "low"
      ]
    },
    "masterReady": {
      "type": "boolean"
    },
    "schedulerWriteAllowed": {
      "const": false
    },
    "persisted": {
      "const": false
    },
    "reasonCodes": {
      "type": "array"
    }
  }
}
