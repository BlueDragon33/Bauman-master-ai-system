{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "BAUMAN_ROADMAP_V2_PRIORITY_RESULT_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidateId",
    "targetId",
    "phaseId",
    "knowledgeState",
    "features",
    "contributions",
    "weightedScore",
    "criticalOverride",
    "reviewOnDemand",
    "disposition",
    "masterReady",
    "schedulerWriteAllowed",
    "persisted",
    "reasonCodes"
