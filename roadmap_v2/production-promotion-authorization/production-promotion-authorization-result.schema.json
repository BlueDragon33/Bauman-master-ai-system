{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "BAUMAN_ROADMAP_V2_PRODUCTION_PROMOTION_AUTHORIZATION_RESULT_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema","receiptId","candidateRef","productionPromotionAuthorizerRef","submittedAuthorizationDecision","reasonCodes",
    "productionReadinessReviewReceiptId","promotionReviewReceiptId","releaseReviewReceiptId","promotionEligibilityProjectionId","humanReviewReceiptId",
    "reportId","phaseId","weekStart","sourceProductionReadinessReviewState","effectiveProductionPromotionAuthorizationState",
    "authorizationReceiptGranted","authorizationScope","persisted","productionPromotionExecuted","deploymentExecuted",
    "productionConsumerConnected","runtimeActionAuthorized","scheduleWriteAllowed","notificationWriteAllowed"
  ],
  "properties": {
    "schema": {"const": "BAUMAN_ROADMAP_V2_PRODUCTION_PROMOTION_AUTHORIZATION_RESULT_V1"},
    "receiptId": {"type": "string","minLength": 1},
    "candidateRef": {"type": "string","pattern": "^CANDIDATE::[A-Z0-9_-]+$"},
    "productionPromotionAuthorizerRef": {"type": "string","pattern": "^PRODUCTION_PROMOTION_AUTHORIZER::[A-Z0-9_-]+$"},
    "submittedAuthorizationDecision": {"enum": ["authorize_receipt_only","needs_revision","rejected"]},
    "reasonCodes": {"type": "array","minItems": 1,"maxItems": 12,"items": {"type": "string","pattern": "^[A-Z0-9_-]{1,64}$"}},
    "productionReadinessReviewReceiptId": {"type": "string","minLength": 1},
    "promotionReviewReceiptId": {"type": "string","minLength": 1},
    "releaseReviewReceiptId": {"type": "string","minLength": 1},
    "promotionEligibilityProjectionId": {"type": "string","minLength": 1},
    "humanReviewReceiptId": {"type": "string","minLength": 1},
    "reportId": {"type": "string","minLength": 1},
    "phaseId": {"enum": ["GD0","GD1","GD2","GD3"]},
    "weekStart": {"type": "string","format": "date"},
    "sourceProductionReadinessReviewState": {"enum": ["production_readiness_review_blocked_upstream","production_readiness_review_needs_revision","production_readiness_review_rejected","production_readiness_review_approved_shadow_only"]},
    "effectiveProductionPromotionAuthorizationState": {"enum": ["production_promotion_authorization_blocked_upstream","production_promotion_authorization_needs_revision","production_promotion_authorization_rejected","production_promotion_authorization_receipt_granted"]},
    "authorizationReceiptGranted": {"type": "boolean"},
    "authorizationScope": {"const": "receipt_only_no_execution"},
    "persisted": {"const": false},
    "productionPromotionExecuted": {"const": false},
    "deploymentExecuted": {"const": false},
    "productionConsumerConnected": {"const": false},
    "runtimeActionAuthorized": {"const": false},
    "scheduleWriteAllowed": {"const": false},
    "notificationWriteAllowed": {"const": false}
  }
}