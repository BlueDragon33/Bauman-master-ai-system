{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "BAUMAN_ROADMAP_V2_PRODUCTION_PROMOTION_AUTHORIZATION_REQUEST_V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","candidateRef","productionPromotionAuthorizerRef","authorizationDecision","reasonCodes","productionReadinessReviewRequest"],
  "properties": {
    "schema": {"const": "BAUMAN_ROADMAP_V2_PRODUCTION_PROMOTION_AUTHORIZATION_REQUEST_V1"},
    "candidateRef": {"type": "string","pattern": "^CANDIDATE::[A-Z0-9_-]+$"},
    "productionPromotionAuthorizerRef": {"type": "string","pattern": "^PRODUCTION_PROMOTION_AUTHORIZER::[A-Z0-9_-]+$"},
    "authorizationDecision": {"enum": ["authorize_receipt_only","needs_revision","rejected"]},
    "reasonCodes": {"type": "array","minItems": 1,"maxItems": 12,"items": {"type": "string","pattern": "^[A-Z0-9_-]{1,64}$"}},
    "productionReadinessReviewRequest": {
      "type": "object",
      "description": "Current BAUMAN_ROADMAP_V2_PRODUCTION_READINESS_REVIEW_REQUEST_V1; recomputed by the L34/L35 harness chain"
    }
  }
}