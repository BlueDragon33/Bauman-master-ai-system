{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "BAUMAN_ROADMAP_V2_PROMOTION_REVIEW_REQUEST_V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","candidateRef","promotionReviewerRef","reviewDecision","reasonCodes","releaseReviewRequest"],
  "properties": {
    "schema": {"const": "BAUMAN_ROADMAP_V2_PROMOTION_REVIEW_REQUEST_V1"},
    "candidateRef": {"type": "string","pattern": "^CANDIDATE::[A-Z0-9_-]+$"},
    "promotionReviewerRef": {"type": "string","pattern": "^PROMOTION_REVIEWER::[A-Z0-9_-]+$"},
    "reviewDecision": {"enum": ["approve_for_production_readiness_review","needs_revision","rejected"]},
    "reasonCodes": {
      "type": "array","minItems": 1,"maxItems": 12,
      "items": {"type": "string","pattern": "^[A-Z0-9_-]{1,64}$"}
    },
    "releaseReviewRequest": {
      "type": "object",
      "description": "Current BAUMAN_ROADMAP_V2_RELEASE_REVIEW_REQUEST_V1; recomputed by the L32/L33 harness chain"
    }
  }
}
