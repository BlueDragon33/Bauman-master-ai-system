{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "BAUMAN_ROADMAP_V2_READINESS_CONTRACT_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "purpose",
    "mode",
    "upstreamSchemas",
    "readinessDimensions",
    "targetPolicy",
    "statusPolicy",
    "overallPolicy",
    "externalGatePolicy",
    "outputPolicy",
    "capabilities",
    "abortConditions",
    "acceptance"
  ],
  "properties": {
    "schema": { "const": "BAUMAN_ROADMAP_V2_READINESS_CONTRACT_V1" },
    "version": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "mode": { "type": "object" },
    "upstreamSchemas": { "type": "object" },
    "readinessDimensions": { "type": "array", "minItems": 5, "uniqueItems": true, "items": { "type": "string" } },
    "targetPolicy": { "type": "object" },
    "statusPolicy": {
      "type": "object",
      "required": ["red", "yellow", "green"],
      "additionalProperties": false,
      "properties": {
        "red": { "type": "object" },
        "yellow": { "type": "object" },
        "green": { "type": "object" }
      }
    },
    "overallPolicy": { "type": "object" },
    "externalGatePolicy": { "type": "object" },
    "outputPolicy": { "type": "object" },
    "capabilities": { "type": "object" },
    "abortConditions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "acceptance": { "type": "object" }
  }
}
