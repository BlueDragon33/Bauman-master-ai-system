{
  "schema": "BAUMAN_ROADMAP_V2_READINESS_CONTRACT_V1",
  "version": "2.7.3-l27-b106-h3-current",
  "purpose": "Read-only readiness projection contract for the current Consumer Blueprint V1 + Mastery V2 + current Scheduler boundary, without persistence, dashboard rendering, runtime or notification writes",
  "mode": {
    "access": "read_only_projection_harness",
    "productionIntegration": "disconnected",
    "failClosed": true,
    "persistentStoreEnabled": false,
    "dashboardUiEnabled": false,
    "runtimeWriteAllowed": false,
    "notificationWriteAllowed": false
  },
  "upstreamSchemas": {
    "consumerBlueprint": "BAUMAN_ROADMAP_V2_CONSUMER_BLUEPRINT_V1",
    "masteryContract": "BAUMAN_ROADMAP_V2_MASTERY_CONTRACT_V2",
    "masterySnapshot": "BAUMAN_ROADMAP_V2_MASTERY_SNAPSHOT_V1",
    "schedulerContract": "BAUMAN_ROADMAP_V2_SCHEDULER_CONTRACT_V1",
    "schedulerRequest": "BAUMAN_ROADMAP_V2_SCHEDULER_REQUEST_V1",
    "schedulerResult": "BAUMAN_ROADMAP_V2_SCHEDULER_RESULT_V1"
  },
  "readinessDimensions": [
    "evidence_availability",
    "prerequisite_gate",
    "mastery_state",
    "critical_schedule_coverage",
    "external_gate_provenance"
  ],
  "targetPolicy": {
    "focusTargetsRequired": true,
    "unknownTargetPolicy": "reject",
    "missingSnapshotPolicy": "red_unknown",
    "unverifiedMasterReadyClaimPolicy": "reject_upstream_or_red_unknown_defense_in_depth",
    "duplicateTargetPolicy": "reject",
    "recommendedAndContextualEdgesBlock": false,
    "externalGatesRemainExplicit": true,
    "prerequisiteResolution": "chapter_policy_inherited_by_lessons",
    "lessonFocusAllowed": true
  },
  "statusPolicy": {
    "red": {
      "code": "blocked_or_unknown",
      "whenAny": [
        "focus target mastery snapshot missing",
        "master_ready claim lacks a passed Master-ready evidence gate",
        "blocking prerequisite unsatisfied",
        "required external gate missing, false or unverified",
        "Critical focus target not scheduled"
      ]
    },
    "yellow": {
      "code": "prerequisite_ready_not_master_ready",
      "whenAll": [
        "focus target mastery snapshot present",
        "blocking prerequisites satisfied",
        "Critical focus target scheduled when applicable",
        "knowledge state is not master_ready"
      ]
    },
    "green": {
      "code": "master_ready",
      "whenAll": [
        "focus target mastery snapshot present",
        "blocking prerequisites satisfied",
        "Critical focus target scheduled when applicable",
        "knowledge state is master_ready",
        "Master-ready evidence gate is present and passed"
      ]
    }
  },
  "overallPolicy": {
    "order": [
      "red if any target is red",
      "yellow if no target is red and any target is yellow",
      "green only if every focus target is green"
    ],
    "emptyFocusSetAllowed": false,
    "manualOverrideAllowed": false
  },
  "externalGatePolicy": {
    "inputShape": "verified gate records",
    "verifiedSourceRequired": true,
    "unknownExternalGatePolicy": "reject",
    "missingGateDefaultsToSatisfied": false,
    "callerBooleanMapAccepted": false
  },
  "outputPolicy": {
    "dependencyEvidenceIncluded": true,
    "reasonCodesIncluded": true,
    "deepFrozen": true,
    "persistentSnapshot": false,
    "uiModelOnly": true
  },
  "capabilities": {
    "requestValidate": true,
    "prerequisiteEvaluate": true,
    "scheduleCoverageEvaluate": true,
    "targetReadinessProject": true,
    "overallReadinessProject": true,
    "persistentStoreWrite": false,
    "dashboardUiRender": false,
    "runtimeActivation": false,
    "notificationWrite": false
  },
  "abortConditions": [
    "current Consumer Blueprint, Mastery V2 or Scheduler current-boundary schema mismatch",
    "dependency on quarantined historical Consumer/Mastery/Scheduler manifest or baseline hash",
    "unknown or duplicate focus target",
    "lesson focus target without an unambiguous current parent chapter",
    "phase mismatch across readiness and schedule request",
    "caller-supplied scheduler result or readiness color",
    "persisted mastery snapshot admitted",
    "unknown, duplicate or unverified external gate",
    "recommended or contextual edge treated as blocking",
    "missing evidence silently treated as ready",
    "unverified master_ready claim reported green",
    "Critical focus target silently treated as covered when unscheduled",
    "Existing Competency or prerequisite-ready state reported green",
    "persistence, UI, runtime or notification write attempted",
    "forged master_ready snapshot rejected by current Priority/Scheduler before readiness projection"
  ],
  "acceptance": {
    "step": 108,
    "currentTrack": "L27",
    "ragSemanticsPinned": true,
    "missingEvidenceFailsClosed": true,
    "masterReadyRequiredForGreen": true,
    "consumerBlueprintBoundaryRevalidated": true,
    "masteryV2BoundaryRevalidated": true,
    "schedulerCurrentBoundaryRevalidated": true,
    "staleManifestDependencyRemoved": true,
    "productionDashboardConnected": false,
    "runtimeActivationAllowed": false,
    "result": "PASS_CLOSEOUT_PENDING_FINAL_STATE_GATE",
    "lessonPrerequisiteInheritancePinned": true,
    "forgedMasterReadyUpstreamRejectionPinned": true
  }
}
