{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "BAUMAN_ROADMAP_V2_READINESS_REQUEST_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "reportId",
    "phaseId",
    "focusTargetIds",
    "scheduleRequest",
    "externalGates"
  ],
  "properties": {
    "schema": { "const": "BAUMAN_ROADMAP_V2_READINESS_REQUEST_V1" },
    "reportId": { "type": "string", "minLength": 1 },
    "phaseId": { "enum": ["GD0", "GD1", "GD2", "GD3"] },
    "focusTargetIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "scheduleRequest": { "type": "object" },
    "externalGates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gateId", "satisfied", "sourceRef", "verified"],
        "properties": {
          "gateId": { "type": "string", "minLength": 1 },
          "satisfied": { "type": "boolean" },
          "sourceRef": { "type": "string", "minLength": 1 },
          "verified": { "const": true }
        }
      }
    }
  }
}
