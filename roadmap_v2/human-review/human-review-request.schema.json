{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "BAUMAN_ROADMAP_V2_HUMAN_REVIEW_REQUEST_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "reviewerRef",
    "reviewDecision",
    "reasonCodes",
    "consumerAdmissionRequest"
  ],
  "properties": {
    "schema": {
      "const": "BAUMAN_ROADMAP_V2_HUMAN_REVIEW_REQUEST_V1"
    },
    "reviewerRef": {
      "type": "string",
      "pattern": "^REVIEWER::[A-Z0-9_-]+$"
    },
    "reviewDecision": {
      "enum": [
        "needs_revision",
        "accepted_for_shadow_analysis",
        "rejected"
      ]
    },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9_:-]+$"
      }
    },
    "consumerAdmissionRequest": {
      "type": "object",
      "description": "Current BAUMAN_ROADMAP_V2_CONSUMER_ADMISSION_REQUEST_V1; revalidated and recomputed by the L29/L30 harness chain"
    }
  }
}
